{
  "name": "@mj-biz-apps/tasks-github-server",
  "type": "module",
  "version": "1.0.0",
  "description": "BizApps Tasks GitHub Extension Server Bootstrap - GraphQL resolvers, webhook middleware, and class registrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "test": "vitest run"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@memberjunction/actions": "6.2.1",
    "@memberjunction/core": "6.2.1",
    "@memberjunction/core-entities": "6.2.1",
    "@memberjunction/global": "6.2.1",
    "@memberjunction/server": "6.2.1",
    "@memberjunction/sqlserver-dataprovider": "6.2.1",
    "@mj-biz-apps/common-entities": "5.62.0",
    "@mj-biz-apps/tasks-entities": "1.11.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "@mj-biz-apps/tasks-github-actions": "^1.0.0",
    "@mj-biz-apps/tasks-github-core": "^1.0.0",
    "@mj-biz-apps/tasks-github-entities": "^1.0.0",
    "class-validator": "^0.14.3"
  },
  "peerDependencies": {
    "@memberjunction/actions": "^6.3.0",
    "@memberjunction/core": "^6.3.0",
    "@memberjunction/core-entities": "^6.3.0",
    "@memberjunction/global": "^6.3.0",
    "@memberjunction/server": "^6.3.0",
    "@memberjunction/sqlserver-dataprovider": "^6.3.0",
    "@mj-biz-apps/common-entities": "^5.62.0",
    "@mj-biz-apps/tasks-entities": "^1.12.0"
  },
  "memberjunction": {
    "serverExtensions": [
      {
        "Enabled": true,
        "DriverClass": "GitHubTasksWebhookServerExtension",
        "RootPath": "/webhooks/github/tasks",
        "Phase": "pre-auth",
        "Settings": {}
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-tasks-github"
  }
}
