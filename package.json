{
  "name": "bizapps-tasks-github",
  "private": true,
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "BizApps Tasks GitHub Extension - GitHub Issue & Pull Request task subtypes, sync, webhooks, and planning field inference for MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:packages",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/tasks-github-entities\" --filter=\"@mj-biz-apps/tasks-github-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/tasks-github-*\"",
    "test": "turbo test --filter=\"@mj-biz-apps/tasks-github-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsTasksGitHub --dir ./migrations",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsTasksGitHub && node scripts/pg-finalize.mjs",
    "mj:codegen": "mj codegen",
    "change": "changeset",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-tasks-github"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.2.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vitest": "1.6.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
